{
  "name": "marketplace-modules",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.10.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3100",
    "build": "next build --webpack",
